background = #11111a
foreground = #c9cad2

# black
palette = 0=#1e1e2d
# red
palette = 1=#cc6666
# green
palette = 2=#9aa251
# yellow
palette = 3=#d89f31
# blue
palette = 4=#7191ad
# magenta
palette = 5=#9f81a9
# cyan
palette = 6=#6ea69f
# white
palette = 7=#c9cad2
# bright black
palette = 8=#6d7084
# bright red
palette = 9=#d54e53
# bright green
palette = 10=#becb63
# bright yellow
palette = 11=#e2c557
# bright blue
palette = 12=#5d81f6
# bright magenta
palette = 13=#c9a5da
# bright cyan
palette = 14=#88c6bb
# bright white
palette = 15=#e4e5ea

# Draw bold text in the bright palette colors (e.g. bold dirs from LSCOLORS in bright blue).
bold-color = bright

# Hand ctrl+tab / ctrl+shift+tab to herdr (which cycles its tabs with them) instead of
# Ghostty's own tabs; those still cycle with cmd+shift+] and cmd+shift+[. Sent as the
# kitty-protocol key codes so herdr can tell them from a plain Tab even in a shell pane.
keybind = ctrl+tab=csi:9;5u
keybind = ctrl+shift+tab=csi:9;6u

# cmd+shift+arrows do what alt+shift+arrows do in herdr (cycle panes left/right, switch
# workspaces up/down): cmd sits where alt does on a PC keyboard, as with cmd+tab / alt+tab.
# Sent as the alt+shift arrow codes so herdr/config.toml stays the same on every platform.
# Replaces Ghostty's cmd+shift+up/down (jump to previous/next prompt).
keybind = super+shift+left=csi:1;4D
keybind = super+shift+right=csi:1;4C
keybind = super+shift+up=csi:1;4A
keybind = super+shift+down=csi:1;4B

# cmd+shift+n / i / c / o open herdr's side panes (new pane, ipython, coding agent, review of
# the agent's newest reply) and cmd+shift+m its reconnect-machines popup, which
# herdr/config.toml binds to alt+shift+n / i / c / o / m. Sent as
# those alt+shift letters in kitty-protocol form (code;4u = shift+alt), for the same reason.
keybind = super+shift+n=csi:110;4u
keybind = super+shift+i=csi:105;4u
keybind = super+shift+c=csi:99;4u
keybind = super+shift+o=csi:111;4u
keybind = super+shift+m=csi:109;4u

# cmd+shift+plus opens a new herdr tab (alt+shift+plus in herdr/config.toml), sent the same
# way. Replaces Ghostty's cmd+plus font-size increase on that chord; cmd+= still does it.
keybind = super+shift+equal=csi:43;4u
