background = #11111a
foreground = #c9cad2

# black
palette = 0=#1e1e2d
# red
palette = 1=#cc6666
# green
palette = 2=#9aa251
# yellow
palette = 3=#d89f31
# blue
palette = 4=#7191ad
# magenta
palette = 5=#9f81a9
# cyan
palette = 6=#6ea69f
# white
palette = 7=#c9cad2
# bright black
palette = 8=#6d7084
# bright red
palette = 9=#d54e53
# bright green
palette = 10=#becb63
# bright yellow
palette = 11=#e2c557
# bright blue
palette = 12=#5d81f6
# bright magenta
palette = 13=#c9a5da
# bright cyan
palette = 14=#88c6bb
# bright white
palette = 15=#e4e5ea

# Draw bold text in the bright palette colors (e.g. bold dirs from LSCOLORS in bright blue).
bold-color = bright

# Hand ctrl+tab / ctrl+shift+tab to herdr (which cycles its tabs with them) instead of
# Ghostty's own tabs; those still cycle with cmd+shift+] and cmd+shift+[. Sent as the
# kitty-protocol key codes so herdr can tell them from a plain Tab even in a shell pane.
keybind = ctrl+tab=csi:9;5u
keybind = ctrl+shift+tab=csi:9;6u
